; -*- mode: emacs-lisp; lexical-binding: t -*-

;; Eldev project file for kasas.el <https://emacs-eldev.github.io/eldev/>.
;; The Makefile is the canonical entry point and needs nothing but Emacs;
;; Eldev is offered as a convenience for contributors who already use it
;; (`eldev test', `eldev lint', `eldev compile').

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'nongnu-elpa)
(eldev-use-package-archive 'melpa)

(setf eldev-project-main-file "kasas.el")

;; Treat byte-compilation warnings as failures, matching CI.
(setf eldev-build-treat-warnings-as-errors t)
